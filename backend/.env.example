# Copy this file to backend/.env and fill in real values. Never commit .env.

# --- Database ---
# Local Postgres (started via `brew services start postgresql@17`, db created with `createdb storylens`)
DATABASE_URL=postgresql+psycopg://localhost:5432/storylens

# --- LLM provider ---
# Keep provider swappable: only "openai" is implemented for the MVP.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# --- Firecrawl (article extraction) ---
# https://www.firecrawl.dev/app -> API Keys. Free tier: 1000 credits/month.
# Works without a key too (Firecrawl "Keyless" tier) but is rate-limited.
FIRECRAWL_API_KEY=

# --- Exa (independent source search) ---
# https://dashboard.exa.ai/api-keys - new accounts get $20 free credit.
EXA_API_KEY=

# How many related sources to fetch full text for per analysis
MAX_RELATED_SOURCES=5

# --- CORS ---
CORS_ORIGINS=http://localhost:5173
